{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SentryDesk",
  "version": "1.0.5",
  "identifier": "com.sentrydesk.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SentryDesk",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "decorations": true,
        "backgroundColor": "#FAFAFA",
        "theme": "Light",
        "label": "main",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "SentryDesk",
    "copyright": "© 2026 SentryDesk",
    "category": "Education",
    "shortDescription": "本地优先的漏洞情报学习工作台",
    "longDescription": "把 CISA KEV、NVD、GHSA 等公开情报源与教学卡、自测题连成一条学习路径，全部数据保存在本机。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../knowledge/*.json",
      "../knowledge/seed/*.json"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "template": "installer.nsi",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "uninstallerHeaderImage": "installer/header.bmp",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxRDA4NkI0Rjc5MkE3RDQKUldUVXA1TDN0SWJRWVY0UTNSd1BLNVN6MjduRDJmdmZxcVVoVFR0akNoYXQ0bExKc2RmWWRVSVEK",
      "endpoints": [
        "https://github.com/MenLan-ov/SentryDesk/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
